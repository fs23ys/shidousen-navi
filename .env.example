# Firebase Console > プロジェクトの設定 > 全般 > マイアプリ の SDK 設定から値をコピーしてください。
# このファイルをコピーして .env.local を作り、実際の値を入れてください(.env.local はgit管理外です)。
# 本番公開(GitHub Pages)時は同じ内容をGitHubリポジトリの Settings > Secrets and variables > Actions に登録します。

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# このアプリへのアクセスを許可する、あなた自身のGoogleアカウントのメールアドレス。
VITE_OWNER_EMAIL=fs.23ys@gmail.com

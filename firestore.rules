rules_version = '2';

// 指導せんナビ:許可された本人アカウントだけが読み書きできるようにするルール。
// 「合言葉」ゲートはFirebase AuthのGoogleサインインで実現しており、
// ここでは「認証済み、かつメールアドレスが許可リストに含まれること」を必須条件にする。
// クライアントコード(GitHub Pagesで誰でも閲覧可能)を隠すことでは保護せず、
// 実際のデータ保護はこのルールで行う。
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['fs.23ys@gmail.com', 'fs.ph.work@gmail.com'];
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
